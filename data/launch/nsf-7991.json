{"id":"nsf-7991","nsf":{"id":7991,"missions":[{"id":8871,"name":"USSF-63","alternative_names":null,"manufacturer":null,"operator":null,"description":"Other payloads for the USSF-63 mission have not yet been announced, due to the classified nature of the mission.","orbit":null,"payloads":null,"mass":null,"wiki_url":""},{"id":9388,"name":"Oracle-M","alternative_names":null,"manufacturer":"General Atomics Electromagnetic Systems","operator":"Air Force Research Laboratory","description":"Oracle-M is a cutting-edge SSA pathfinder satellite designed to provide persistent situational awareness in cislunar space, demonstrating new tracking and navigation capabilities essential for future space operations. The mission will showcase tracking and trajectory estimation for monitoring cislunar objects, cloud-based ground operations with integrated government and contractor collaboration, and navigation and communications using affordable commercial ground systems. It will also support data collection and distribution to those charged with maintaining cislunar situational awareness.\r\n\r\nOracle-M is a secondary payload on the USSF-63 mission.","orbit":"Earth-Moon L1","payloads":1,"mass":null,"wiki_url":""}],"status":{"id":0,"name":"TBD Date & Time","icon_name":"calendar-question","color":"#0076C9"},"rocket_config":{"id":5,"agency":{"id":1,"logo":"https://media.nextspaceflight.com/media/agencies/spacex.webp","transparent_logo":false,"name":"SpaceX","abbrev":"SpaceX","region":1,"active":true,"government":false,"administrator":"Elon Musk","founding_year":2002,"num_socials":5,"stats_num_launches":true},"image":"https://media.nextspaceflight.com/media/rockets/40628435833_a1bcde59db_o.webp","thumbnail":"https://media.nextspaceflight.com/media/rockets-thumb/40628435833_a1bcde59db_o.webp","rocket_name":"Falcon Heavy","rocket_show_stats":true,"name":"Falcon Heavy","diameter":null,"height":70,"payload_leo":63800,"payload_gto":26700,"liftoff_thrust":22819,"fairing_diameter":5.2,"fairing_h